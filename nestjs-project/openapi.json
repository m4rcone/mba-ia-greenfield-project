        "properties": {}
      },
      "InitiateUploadDto": {
        "type": "object",
        "properties": {
          "fileName": {
            "type": "string",
            "example": "my-video.mp4",
            "minLength": 1,
            "maxLength": 255,
            "description": "Extension must be one of .mp4, .m4v, .mov, .webm"
          },
          "contentType": {
            "type": "string",
            "example": "video/mp4",
            "enum": [
              "video/mp4",
              "video/quicktime",
              "video/webm"
            ],
            "description": "Must agree with the fileName extension"
          },
          "fileSize": {
            "type": "number",
            "example": 10737418240,
            "minimum": 1,
            "description": "Size in bytes, at most UPLOAD_MAX_SIZE_BYTES (default 10 GiB)"
          }
        },
        "required": [
          "fileName",
          "contentType",
          "fileSize"
        ]
      },
      "InitiateUploadResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "public_id": {
            "type": "string",
            "example": "aB3dE5gH7jK",
            "pattern": "^[0-9A-Za-z]{11}$"
          },
          "title": {
            "type": "string",
            "example": "my-video"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft"
            ],
            "example": "draft"
          },
          "processing_status": {
            "type": "string",
            "enum": [
              "uploading",
              "processing",
              "ready",
              "failed"
            ],
            "example": "uploading"
          },
          "partSize": {
            "type": "number",
            "example": 16777216,
            "description": "Bytes per part"
          },
          "partCount": {
            "type": "number",
            "example": 640
          }
        },
        "required": [
          "id",
          "public_id",
          "title",
          "status",
          "processing_status",
          "partSize",
          "partCount"
        ]
      },
      "PresignPartsDto": {
        "type": "object",
        "properties": {
          "partNumbers": {
            "example": [
              1,
              2,
              3
            ],
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "description": "Part numbers ≥ 1 and ≤ the upload partCount",
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "partNumbers"
        ]
      },
      "PresignedPartDto": {
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "number",
            "example": 1
          },
          "url": {
            "type": "string",
            "description": "Presigned UploadPart URL (HTTP PUT)"
          }
        },
        "required": [
          "partNumber",
          "url"
        ]
      },
      "PresignPartsResponseDto": {
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PresignedPartDto"
            }
          },
          "expiresIn": {
            "type": "number",
            "example": 900,
            "description": "URL TTL in seconds"
          }
        },
        "required": [
          "parts",
          "expiresIn"
        ]
      },
      "UploadedPartDto": {
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "number",
            "example": 1
          },
          "size": {
            "type": "number",
            "example": 16777216
          }
        },
        "required": [
          "partNumber",
          "size"
        ]
      },
      "UploadedPartsResponseDto": {
        "type": "object",
        "properties": {
          "partSize": {
            "type": "number",
            "example": 16777216
          },
          "partCount": {
            "type": "number",
            "example": 640
          },
          "uploadedParts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadedPartDto"
            }
          }
        },
        "required": [
          "partSize",
          "partCount",
          "uploadedParts"
        ]
      },
      "CompleteUploadResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "public_id": {
            "type": "string",
            "example": "aB3dE5gH7jK"
          },
          "processing_status": {
            "type": "string",
            "enum": [
              "uploading",
              "processing",
              "ready",
              "failed"
            ],
            "example": "processing"
          }
        },
        "required": [
          "id",
          "public_id",
          "processing_status"
        ]
      },
      "VideoResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "public_id": {
            "type": "string",
            "example": "aB3dE5gH7jK"
          },
          "title": {
            "type": "string",
            "example": "my-video"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft"
            ]
          },
          "processing_status": {
            "type": "string",
            "enum": [
              "uploading",
              "processing",
              "ready",
              "failed"
            ]
          },
          "processing_error": {
            "type": "string",
            "nullable": true,
            "example": null,
            "description": "NOT_A_VIDEO | UNSUPPORTED_CONTAINER | UNSUPPORTED_CODEC | CORRUPT_MEDIA | PROCESSING_FAILED | UPLOAD_SIZE_MISMATCH | UPLOAD_CANCELLED | UPLOAD_ABANDONED; null unless failed"
          },
          "duration_seconds": {
            "type": "number",
            "nullable": true,
            "example": 12.345
          },
          "width": {
            "type": "number",
            "nullable": true,
            "example": 1920
          },
          "height": {
            "type": "number",
            "nullable": true,
            "example": 1080
          },
          "video_codec": {
            "type": "string",
            "nullable": true,
            "example": "h264"
          },
          "audio_codec": {
            "type": "string",
            "nullable": true,
            "example": "aac"
          },
          "thumbnail_url": {
            "type": "string",
            "nullable": true,
            "description": "Public URL of the thumbnail (anonymous read); null until processing_status=ready"
          }
        },
        "required": [
          "id",
          "public_id",
          "title",
          "status",
          "processing_status",
          "processing_error",
          "duration_seconds",
          "width",
          "height",
          "video_codec",
          "audio_codec",
          "thumbnail_url"
        ]
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
}